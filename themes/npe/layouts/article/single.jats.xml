{{- /* JATS XML for one article, shaped after the Vestnik MEPhI file accepted by
      IS "Metaphora" (bilingual RU+EN, Publishing DTD v1.3). The canonical file is
      generated by the Russian build; EN data is read from content_en siblings.
      Enabled per-page via outputs=["HTML", "JATS"]. */ -}}
{{- if .Params.doi -}}
{{- $en := partial "get-jats-en-data" . -}}
{{- $doi := replace .Params.doi "https://doi.org/" "" -}}
{{- $issueParts := split (.Params.issue | default "") "-" -}}
{{- $year := index $issueParts 0 -}}
{{- $issueNum := "" -}}
{{- if ge (len $issueParts) 2 -}}
  {{- $issueNum = index $issueParts 1 -}}
  {{- if eq (substr $issueNum 0 1) "0" -}}{{- $issueNum = substr $issueNum 1 1 -}}{{- end -}}
{{- end -}}
{{- $abstract := partial "get-xml-abstract" . -}}
{{- $refs := partial "get-xml-refs" . -}}
{{- $holder := .Site.Params.jats_copyright_holder -}}
{{- $stmt := replace (.Site.Params.jats_copyright_statement | default "") "{holder}" $holder -}}
{{- $stmt = replace $stmt "{year}" $year -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE article PUBLIC "-//NLM//DTD JATS (Z39.96) Journal Publishing DTD v1.3 20210610//EN" "JATS-journalpublishing1-3.dtd">
<article article-type="research-article" dtd-version="1.3" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xml:lang="ru"><front><journal-meta><journal-id journal-id-type="publisher-id">npe</journal-id><journal-title-group><journal-title xml:lang="ru">{{ .Site.Title | html }}</journal-title><trans-title-group xml:lang="en"><trans-title>Izvestiya vuzov. Yadernaya Energetika</trans-title></trans-title-group></journal-title-group><issn pub-type="ppub">0204-3327</issn><publisher><publisher-name>National Research Nuclear University MEPhI (Moscow Engineering Physics Institute)</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="doi">{{ $doi }}</article-id>
{{- with .Params.rubric_name }}
<article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group><subj-group subj-group-type="section-heading" xml:lang="ru"><subject>{{ . | partial "get-xml-clean" | html }}</subject></subj-group>
{{- with $en.rubric_name }}
<subj-group subj-group-type="section-heading" xml:lang="en"><subject>{{ . | partial "get-xml-clean" | html }}</subject></subj-group>
{{- end }}
</article-categories>
{{- end }}
<title-group><article-title>{{ .Params.title | partial "get-xml-clean" | html }}</article-title>
{{- with $en.title }}
<trans-title-group xml:lang="en"><trans-title>{{ . | partial "get-xml-clean" | html }}</trans-title></trans-title-group>
{{- end }}
</title-group><contrib-group>
{{- $.Scratch.Set "affseq" 0 -}}
{{- $.Scratch.Set "afflist" slice -}}
{{- range .Params.authors -}}
  {{- $term := . -}}
  {{- with index $.Site.Data.authors $term -}}
  {{- $a := partial "get-xml-author" . -}}
  {{- $enA := partial "get-xml-author" (partial "get-jats-en-author" $term) -}}
  {{- $rid := "" -}}
  {{- $enOrg := "" -}}
  {{- if $a.org -}}
    {{- $affKey := printf "aff-%s" $a.org -}}
    {{- $rid = $.Scratch.Get $affKey -}}
    {{- if not $rid -}}
      {{- $.Scratch.Add "affseq" 1 -}}
      {{- $rid = printf "aff%d" ($.Scratch.Get "affseq") -}}
      {{- $.Scratch.Set $affKey $rid -}}
      {{- $.Scratch.Add "afflist" (dict "id" $rid "ru" $a.org "en" $enA.org) -}}
    {{- end -}}
    {{- $enOrg = $enA.org -}}
  {{- end -}}
<contrib contrib-type="author">
{{- with or $a.orcid $enA.orcid }}
<contrib-id contrib-id-type="orcid">{{ . }}</contrib-id>
{{- end }}
<name-alternatives><name name-style="eastern" xml:lang="ru"><surname>{{ $a.surname | partial "get-xml-clean" | html }}</surname><given-names>{{ $a.given | partial "get-xml-clean" | html }}</given-names></name>
{{- with $enA.surname }}
<name name-style="western" xml:lang="en"><surname>{{ . | partial "get-xml-clean" | html }}</surname><given-names>{{ $enA.given | partial "get-xml-clean" | html }}</given-names></name>
{{- end }}
</name-alternatives>
{{- with $a.regals }}
<bio xml:lang="ru"><p>{{ . | partial "get-xml-clean" | html }}</p></bio>
{{- end }}
{{- with $enA.regals }}
<bio xml:lang="en"><p>{{ . | partial "get-xml-clean" | html }}</p></bio>
{{- end }}
{{- with $rid }}
<xref ref-type="aff" rid="{{ . }}"/>
{{- end }}
</contrib>
  {{- end -}}
{{- end }}
</contrib-group>
{{- range $.Scratch.Get "afflist" }}
<aff-alternatives id="{{ .id }}"><aff xml:lang="ru">{{ .ru | partial "get-xml-clean" | html }}</aff>
{{- with .en }}
<aff xml:lang="en">{{ . | partial "get-xml-clean" | html }}</aff>
{{- end }}
</aff-alternatives>
{{- end }}
<pub-date pub-type="collection"><year>{{ $year }}</year></pub-date><pub-date pub-type="epub"><day>{{ dateFormat "02" .Date }}</day><month>{{ dateFormat "01" .Date }}</month><year>{{ dateFormat "2006" .Date }}</year></pub-date>
{{- with $year }}
<volume>{{ . }}</volume>
{{- end }}
{{- with $issueNum }}
<issue>{{ . }}</issue>
{{- end }}
{{- with .Params.first_page }}
<fpage>{{ . }}</fpage>
{{- end }}
{{- with .Params.last_page }}
<lpage>{{ . }}</lpage>
{{- end }}
<permissions><copyright-statement>{{ $stmt | html }}</copyright-statement><copyright-year>{{ $year }}</copyright-year><copyright-holder xml:lang="ru">{{ $holder | html }}</copyright-holder><copyright-holder xml:lang="en">National Research Nuclear University MEPhI</copyright-holder></permissions>
<self-uri xlink:href="{{ .Permalink }}">{{ .Permalink }}</self-uri>
{{- with $abstract }}
<abstract>
{{- range . }}
<p>{{ . | html }}</p>
{{- end }}
</abstract>
{{- end }}
{{- with $en.abstract }}
<trans-abstract xml:lang="en"><p>{{ . | html }}</p></trans-abstract>
{{- end }}
{{- with .Params.tags }}
<kwd-group xml:lang="ru">
{{- range . }}
<kwd>{{ . | partial "get-xml-clean" | html }}</kwd>
{{- end }}
</kwd-group>
{{- end }}
{{- with $en.tags }}
<kwd-group xml:lang="en">
{{- range . }}
<kwd>{{ . | partial "get-xml-clean" | html }}</kwd>
{{- end }}
</kwd-group>
{{- end }}
{{- with .Params.udc }}
<custom-meta-group><custom-meta><meta-name>UDC</meta-name><meta-value>{{ . | partial "get-xml-clean" | html }}</meta-value></custom-meta></custom-meta-group>
{{- end }}
</article-meta></front>
{{- with $refs }}
<back><ref-list><title>References</title>
{{- range $i, $r := . }}
<ref id="cit{{ add $i 1 }}"><label>{{ add $i 1 }}</label><citation-alternatives><mixed-citation xml:lang="ru">{{ $r | html }}</mixed-citation>
{{- $enRefs := $en.refs }}
{{- if lt $i (len $enRefs) }}
{{- with index $enRefs $i }}
<mixed-citation xml:lang="en">{{ . | html }}</mixed-citation>
{{- end }}
{{- end }}
</citation-alternatives></ref>
{{- end }}
</ref-list></back>
{{- end }}
</article>
{{- end -}}
